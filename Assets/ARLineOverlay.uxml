<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Fullscreen visual-only overlay. picking-mode=Ignore on everything — no UI Toolkit elements intercept touch. -->
    <!-- The Scan Button is now a uGUI Button on a separate Screen Space Overlay Canvas. -->
    <ui:VisualElement name="HUDOverlay" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%;" />
</ui:UXML>
