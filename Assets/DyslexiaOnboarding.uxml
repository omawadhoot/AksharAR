<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/DyslexiaOnboarding.uss?fileID=7433441132597879392&amp;guid=0296a755d2a3f724b877d0d16a878f29&amp;type=3#DyslexiaOnboarding"/>
    <ui:VisualElement name="OnboardingModalBackdrop" picking-mode="Position" class="wizard-fullscreen-root">
        <ui:VisualElement name="WizardTopBar" picking-mode="Ignore" class="wizard-top-bar">
            <ui:VisualElement name="WizardProgressSegments" picking-mode="Ignore" class="wizard-progress-bar">
                <ui:VisualElement name="ProgressSeg1" picking-mode="Ignore" class="wizard-progress-seg wizard-progress-seg--active"/>
                <ui:VisualElement name="ProgressSeg2" picking-mode="Ignore" class="wizard-progress-seg"/>
                <ui:VisualElement name="ProgressSeg3" picking-mode="Ignore" class="wizard-progress-seg"/>
                <ui:VisualElement name="ProgressSeg4" picking-mode="Ignore" class="wizard-progress-seg"/>
            </ui:VisualElement>
            <ui:Label name="WizardStepAccessibleLabel" text="1/4" picking-mode="Ignore" class="wizard-step-accessible-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="WizardContentArea" picking-mode="Ignore" class="wizard-content-area">
            <ui:VisualElement name="WizardSlateContainer" picking-mode="Ignore" class="wizard-slate-frame">
                <ui:VisualElement picking-mode="Ignore" class="wizard-slate-top-header">
                    <ui:Label text="📝 वाचन पाटी  •  READING SLATE" picking-mode="Ignore" class="wizard-slate-header-title"/>
                </ui:VisualElement>
                <ui:VisualElement name="WizardLivePreviewCard" picking-mode="Ignore" class="wizard-live-preview-box">
                    <ui:Label name="PreviewLiveLine1" text="सुंदर फुले उमलली बागेत छान" picking-mode="Ignore" class="wizard-preview-line"/>
                    <ui:Label name="PreviewLiveLine2" text="हळूच वारा सांगे आनंदाचे गाण" picking-mode="Ignore" class="wizard-preview-line"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="WizardStep1" picking-mode="Ignore" class="wizard-step-page" style="display: none;">
                <ui:VisualElement picking-mode="Ignore" class="wizard-prompt-row">
                    <ui:Label text="तुम्हाला कोणते वाचन अंतर योग्य वाटते?" picking-mode="Ignore" class="wizard-prompt"/>
                    <ui:Button name="BtnTtsStep1" picking-mode="Position" class="wizard-tts-btn">
                        <ui:Label text="🔊" picking-mode="Ignore" class="wizard-tts-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="CardSeverityMild" picking-mode="Position" class="wizard-option-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="कमी अंतर" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="सुंदर फुले उमलली बागेत छान" picking-mode="Ignore" class="wizard-card-preview"/>
                </ui:VisualElement>
                <ui:VisualElement name="CardSeverityModerate" picking-mode="Position" class="wizard-option-card wizard-card--selected">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="मध्यम अंतर" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="सुं·दर  फु·ले  उ·म·ल·ली  बा·गे·त  छा·न" picking-mode="Ignore" class="wizard-card-preview"/>
                </ui:VisualElement>
                <ui:VisualElement name="CardSeverityIntensive" picking-mode="Position" class="wizard-option-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="जास्त अंतर" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="सुं · दर   फु · ले   उ · म · ल · ली   बा · गे · त   छा · न" picking-mode="Ignore" class="wizard-card-preview wizard-card-preview--expanded"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="WizardStep2" picking-mode="Ignore" class="wizard-step-page" style="display: none;">
                <ui:VisualElement picking-mode="Ignore" class="wizard-prompt-row">
                    <ui:Label text="कोणता अक्षरांचा रंग वाचायला सोपा वाटतो?" picking-mode="Ignore" class="wizard-prompt"/>
                    <ui:Button name="BtnTtsStep2" picking-mode="Position" class="wizard-tts-btn">
                        <ui:Label text="🔊" picking-mode="Ignore" class="wizard-tts-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="ChipPaletteCobalt" picking-mode="Position" class="wizard-palette-card wizard-card--selected">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="निळा रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="&lt;color=#141414&gt;सुं&lt;/color&gt;&lt;color=#1E40AF&gt;दर&lt;/color&gt; &lt;color=#141414&gt;फु&lt;/color&gt;&lt;color=#1E40AF&gt;ले&lt;/color&gt; &lt;color=#141414&gt;उ&lt;/color&gt;&lt;color=#1E40AF&gt;म&lt;/color&gt;&lt;color=#141414&gt;ल&lt;/color&gt;&lt;color=#1E40AF&gt;ली&lt;/color&gt; &lt;color=#141414&gt;बा&lt;/color&gt;&lt;color=#1E40AF&gt;गे&lt;/color&gt;&lt;color=#141414&gt;त&lt;/color&gt; &lt;color=#1E40AF&gt;छा&lt;/color&gt;&lt;color=#141414&gt;न&lt;/color&gt;" picking-mode="Ignore" class="wizard-palette-sample"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipPaletteAmber" picking-mode="Position" class="wizard-palette-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="सोनेरी रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="&lt;color=#141414&gt;सुं&lt;/color&gt;&lt;color=#9A3412&gt;दर&lt;/color&gt; &lt;color=#141414&gt;फु&lt;/color&gt;&lt;color=#9A3412&gt;ले&lt;/color&gt; &lt;color=#141414&gt;उ&lt;/color&gt;&lt;color=#9A3412&gt;म&lt;/color&gt;&lt;color=#141414&gt;ल&lt;/color&gt;&lt;color=#9A3412&gt;ली&lt;/color&gt; &lt;color=#141414&gt;बा&lt;/color&gt;&lt;color=#9A3412&gt;गे&lt;/color&gt;&lt;color=#141414&gt;त&lt;/color&gt; &lt;color=#9A3412&gt;छा&lt;/color&gt;&lt;color=#141414&gt;न&lt;/color&gt;" picking-mode="Ignore" class="wizard-palette-sample"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipPaletteViolet" picking-mode="Position" class="wizard-palette-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="जांभळा रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="&lt;color=#1E293B&gt;सुं&lt;/color&gt;&lt;color=#5B21B6&gt;दर&lt;/color&gt; &lt;color=#1E293B&gt;फु&lt;/color&gt;&lt;color=#5B21B6&gt;ले&lt;/color&gt; &lt;color=#1E293B&gt;उ&lt;/color&gt;&lt;color=#5B21B6&gt;म&lt;/color&gt;&lt;color=#1E293B&gt;ल&lt;/color&gt;&lt;color=#5B21B6&gt;ली&lt;/color&gt; &lt;color=#1E293B&gt;बा&lt;/color&gt;&lt;color=#5B21B6&gt;गे&lt;/color&gt;&lt;color=#1E293B&gt;त&lt;/color&gt; &lt;color=#5B21B6&gt;छा&lt;/color&gt;&lt;color=#1E293B&gt;न&lt;/color&gt;" picking-mode="Ignore" class="wizard-palette-sample"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipPaletteMonochrome" picking-mode="Position" class="wizard-palette-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-card-header-row">
                        <ui:Label text="साधा / काळा रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check"/>
                    </ui:VisualElement>
                    <ui:Label text="&lt;color=#0F172A&gt;सुंदर फुले उमलली बागेत छान&lt;/color&gt;" picking-mode="Ignore" class="wizard-palette-sample"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="WizardStep3" picking-mode="Ignore" class="wizard-step-page" style="display: none;">
                <ui:VisualElement picking-mode="Ignore" class="wizard-prompt-row">
                    <ui:Label text="कोणता कागदाचा रंग वाचायला सोपा वाटतो?" picking-mode="Ignore" class="wizard-prompt"/>
                    <ui:Button name="BtnTtsStep3" picking-mode="Position" class="wizard-tts-btn">
                        <ui:Label text="🔊" picking-mode="Ignore" class="wizard-tts-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="ChipTintCream" picking-mode="Position" class="wizard-tint-card wizard-tint-card--cream wizard-card--selected">
                    <ui:Label text="क्रीमी कागद" picking-mode="Ignore" class="wizard-tint-benefit"/>
                    <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check wizard-tint-check"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipTintMint" picking-mode="Position" class="wizard-tint-card wizard-tint-card--mint">
                    <ui:Label text="हलका हिरवा" picking-mode="Ignore" class="wizard-tint-benefit"/>
                    <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check wizard-tint-check"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipTintPeriwinkle" picking-mode="Position" class="wizard-tint-card wizard-tint-card--periwinkle">
                    <ui:Label text="हलका निळा" picking-mode="Ignore" class="wizard-tint-benefit"/>
                    <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check wizard-tint-check"/>
                </ui:VisualElement>
                <ui:VisualElement name="ChipTintPaper" picking-mode="Position" class="wizard-tint-card wizard-tint-card--paper">
                    <ui:Label text="नैसर्गिक कागद" picking-mode="Ignore" class="wizard-tint-benefit"/>
                    <ui:Label text="✓" picking-mode="Ignore" class="wizard-card-check wizard-tint-check"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="WizardStep4" picking-mode="Ignore" class="wizard-step-page" style="display: flex;">
                <ui:VisualElement picking-mode="Ignore" class="wizard-prompt-row">
                    <ui:Label text="वाचन पूर्वावलोकन (तयार आहे)" picking-mode="Ignore" class="wizard-prompt"/>
                    <ui:Button name="BtnTtsStep4" picking-mode="Position" class="wizard-tts-btn">
                        <ui:Label text="🔊" picking-mode="Ignore" class="wizard-tts-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="ReviewRowSpacing" picking-mode="Position" class="wizard-option-card wizard-review-compact-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-review-header-row">
                        <ui:Label text="वाचन अंतर" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="बदला ✎" picking-mode="Ignore" class="wizard-review-edit-chip"/>
                    </ui:VisualElement>
                    <ui:Label name="ReviewValueSpacing" text="मध्यम अंतर" picking-mode="Ignore" class="wizard-card-preview wizard-review-val"/>
                </ui:VisualElement>
                <ui:VisualElement name="ReviewRowColour" picking-mode="Position" class="wizard-option-card wizard-review-compact-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-review-header-row">
                        <ui:Label text="अक्षरांचा रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="बदला ✎" picking-mode="Ignore" class="wizard-review-edit-chip"/>
                    </ui:VisualElement>
                    <ui:Label name="ReviewValueColour" text="निळा रंग" picking-mode="Ignore" class="wizard-card-preview wizard-review-val"/>
                </ui:VisualElement>
                <ui:VisualElement name="ReviewRowPaper" picking-mode="Position" class="wizard-option-card wizard-review-compact-card">
                    <ui:VisualElement picking-mode="Ignore" class="wizard-review-header-row">
                        <ui:Label text="कागदाचा रंग" picking-mode="Ignore" class="wizard-card-title"/>
                        <ui:Label text="बदला ✎" picking-mode="Ignore" class="wizard-review-edit-chip"/>
                    </ui:VisualElement>
                    <ui:Label name="ReviewValuePaper" text="क्रीमी कागद" picking-mode="Ignore" class="wizard-card-preview wizard-review-val"/>
                </ui:VisualElement>
                <ui:Label text="💡 तुम्ही हे पर्याय नंतर Settings मध्ये कधीही बदलू शकता." picking-mode="Ignore" class="wizard-change-later-note"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WizardFooter" picking-mode="Ignore" class="wizard-footer">
            <ui:Button name="WizardBackButton" picking-mode="Position" text="डिफॉल्ट वापरा" class="wizard-nav-btn wizard-btn--secondary"/>
            <ui:Button name="WizardNextButton" picking-mode="Position" text="पुढे →" class="wizard-nav-btn wizard-btn--next"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
