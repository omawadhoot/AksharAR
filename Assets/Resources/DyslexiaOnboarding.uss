/* ── Dyslexia Full-Screen Ergonomic Onboarding USS (1080x2400 Proportional) ── */

.wizard-fullscreen-root,
.wizard-top-bar,
.wizard-brand-wordmark,
.wizard-step-accessible-label,
.wizard-prompt,
.wizard-step-purpose,
.wizard-card-title,
.wizard-card-preview,
.wizard-palette-sample,
.wizard-tint-benefit,
.wizard-preview-line,
.wizard-preview-summary,
.wizard-change-later-note,
.wizard-nav-btn,
.wizard-btn--skip {
    -unity-font: url("project://database/Assets/Fonts/NeevA-Dyslexia-Regular.ttf?fileID=12800000&guid=83e005baf2790934ebb370ef42525d05&type=3#NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
}

/* ── 1. Full-Screen Safe-Area Root (1080x2400 Responsive) ── */
.wizard-fullscreen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(10, 15, 29);
    flex-direction: column;
    justify-content: space-between;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 56px;
    padding-bottom: 56px;
}

/* ── 2. Top Bar: Wordmark + Progress Segments + Close Button ── */
.wizard-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 84px;
    margin-bottom: 16px;
}

.wizard-brand-group {
    flex-direction: column;
    justify-content: center;
}

.wizard-brand-wordmark {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(56, 189, 248);
}

.wizard-step-accessible-label {
    font-size: 20px;
    color: rgb(148, 163, 184);
    margin-top: 2px;
}

.wizard-progress-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 20px;
}

.wizard-progress-seg {
    width: 64px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.18);
    margin-left: 5px;
    margin-right: 5px;
    transition-property: background-color, width;
    transition-duration: 0.2s;
}

.wizard-progress-seg--active {
    background-color: rgb(56, 189, 248);
    width: 80px;
}

.wizard-close-btn {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.wizard-close-btn:active {
    background-color: rgba(239, 68, 68, 0.7);
    scale: 0.92;
}

.wizard-close-icon {
    font-size: 32px;
    color: rgb(226, 232, 240);
    -unity-text-align: middle-center;
}

/* ── 3. Middle Content Area ── */
.wizard-content-area {
    flex-direction: column;
    width: 100%;
    flex-grow: 1;
    justify-content: flex-start;
}

/* ── Persistent Cumulative Live Preview Box ── */
.wizard-live-preview-box {
    background-color: rgb(250, 248, 242);
    border-radius: 22px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    min-height: 190px;
    justify-content: center;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.12);
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-preview-line {
    font-size: 36px;
    color: rgb(20, 20, 20);
    -unity-text-align: middle-left;
    white-space: nowrap;
    margin-bottom: 8px;
}

/* ── Step Pages ── */
.wizard-step-page {
    flex-direction: column;
    width: 100%;
    flex-grow: 1;
}

.wizard-step-purpose {
    font-size: 24px;
    color: rgb(148, 163, 184);
    margin-bottom: 12px;
    line-height: 1.3;
}

.wizard-prompt-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.wizard-prompt {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(241, 245, 249);
    line-height: 1.25;
    flex-grow: 1;
    flex-shrink: 1;
}

.wizard-tts-btn {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(2, 132, 199, 0.25);
    border-width: 2px;
    border-color: rgba(56, 189, 248, 0.6);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 14px;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.wizard-tts-btn:active {
    background-color: rgb(2, 132, 199);
    scale: 0.92;
}

.wizard-tts-icon {
    font-size: 32px;
    color: rgb(56, 189, 248);
    -unity-text-align: middle-center;
}

/* ── Step 1 Option Cards (Generous touch target and clear scale) ── */
.wizard-option-card {
    background-color: rgb(22, 30, 49);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 22px;
    padding-bottom: 22px;
    margin-bottom: 18px;
    min-height: 145px;
    flex-direction: column;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.15s;
}

.wizard-option-card:active {
    scale: 0.98;
}

.wizard-card--selected {
    border-color: rgb(56, 189, 248);
    background-color: rgb(26, 46, 78);
}

.wizard-card-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
    margin-bottom: 8px;
}

.wizard-card-preview {
    font-size: 32px;
    color: rgb(226, 232, 240);
    white-space: nowrap;
}

/* ── Step 2 Palette Cards ── */
.wizard-palette-card {
    background-color: rgb(250, 248, 242);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.12);
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 18px;
    padding-bottom: 18px;
    margin-bottom: 16px;
    min-height: 120px;
    flex-direction: column;
    justify-content: center;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.wizard-palette-card:active {
    scale: 0.98;
}

.wizard-palette-card.wizard-card--selected {
    border-color: rgb(2, 132, 199);
    border-width: 4.5px;
}

.wizard-palette-card .wizard-card-title {
    color: rgb(15, 23, 42);
    margin-bottom: 4px;
    font-size: 24px;
}

.wizard-palette-sample {
    font-size: 34px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 3 Paper Tint Cards ── */
.wizard-tint-card {
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.12);
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-bottom: 16px;
    align-items: center;
    justify-content: center;
    min-height: 105px;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.wizard-tint-card:active {
    scale: 0.98;
}

.wizard-tint-card.wizard-card--selected {
    border-color: rgb(2, 132, 199);
    border-width: 4.5px;
}

.wizard-tint-card--cream {
    background-color: rgb(250, 248, 242);
}

.wizard-tint-card--mint {
    background-color: rgb(240, 253, 244);
}

.wizard-tint-card--periwinkle {
    background-color: rgb(241, 245, 249);
}

.wizard-tint-card--paper {
    background-color: rgb(250, 245, 232);
}

.wizard-tint-benefit {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 4 Review Subtitle & Note ── */
.wizard-preview-summary {
    font-size: 30px;
    color: rgb(56, 189, 248);
    -unity-font-style: bold;
    margin-top: 24px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.wizard-change-later-note {
    font-size: 24px;
    color: rgb(148, 163, 184);
    margin-top: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── 4. Bottom Action Bar (Thumb-Height Ergonomics) ── */
.wizard-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100px;
    padding-top: 14px;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.wizard-nav-btn {
    height: 80px;
    min-width: 180px;
    border-radius: 40px;
    padding-left: 36px;
    padding-right: 36px;
    font-size: 28px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-width: 0;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.wizard-btn--back {
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(226, 232, 240);
}

.wizard-btn--back:active {
    background-color: rgba(255, 255, 255, 0.25);
    scale: 0.95;
}

.wizard-btn--skip {
    background-color: transparent;
    color: rgb(148, 163, 184);
    font-size: 24px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-width: 0;
    min-height: 54px;
}

.wizard-btn--skip:active {
    color: rgb(241, 245, 249);
    scale: 0.95;
}

.wizard-btn--next {
    background-color: rgb(2, 132, 199);
    color: rgb(255, 255, 255);
    min-width: 200px;
}

.wizard-btn--next:active {
    background-color: rgb(3, 105, 161);
    scale: 0.95;
}
