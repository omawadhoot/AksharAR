/* ── Dyslexia Onboarding USS: reference canvas 1080x2400 (PanelSettings: ScaleWithScreenSize).
      1 dp on a typical phone ~= 2.8 reference px, so body text >= 44px (~16dp) and
      touch targets >= 134px (48dp) where interactive and not span-wide. ── */

.wizard-fullscreen-root,
.wizard-top-bar,
.wizard-brand-wordmark,
.wizard-step-accessible-label,
.wizard-prompt,
.wizard-step-purpose,
.wizard-card-title,
.wizard-card-preview,
.wizard-palette-sample,
.wizard-tint-benefit,
.wizard-preview-line,
.wizard-preview-summary,
.wizard-change-later-note,
.wizard-preview-caption,
.wizard-chip-label,
.wizard-review-title,
.wizard-review-value,
.wizard-nav-btn,
.wizard-btn--skip {
    -unity-font: url("project://database/Assets/Fonts/NeevA-Dyslexia-Regular.ttf?fileID=12800000&guid=83e005baf2790934ebb370ef42525d05&type=3#NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
}

/* ── 1. Full-screen root with safe-area padding ── */
.wizard-fullscreen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(10, 15, 29);
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 84px;
    padding-bottom: 72px;
}

/* ── 2. Top bar ── */
.wizard-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 112px;
    flex-shrink: 0;
}

.wizard-brand-group {
    flex-direction: column;
    justify-content: center;
}

.wizard-brand-wordmark {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(56, 189, 248);
}

/* Kept in the tree for screen readers / logs, never shown to the child */
.wizard-step-accessible-label {
    display: none;
    font-size: 26px;
    color: rgb(148, 163, 184);
}

.wizard-progress-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.wizard-progress-seg {
    width: 84px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.18);
    margin-left: 7px;
    margin-right: 7px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-progress-seg--active {
    background-color: rgb(56, 189, 248);
}

.wizard-close-btn {
    display: none;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin: 0;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.wizard-close-btn:active {
    background-color: rgba(239, 68, 68, 0.7);
    scale: 0.92;
}

.wizard-close-icon {
    font-size: 44px;
    color: rgb(226, 232, 240);
    -unity-text-align: middle-center;
}

/* ── 3. Content area: preview (fixed) + step page (takes all remaining height) ── */
.wizard-content-area {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    margin-top: 28px;
    margin-bottom: 28px;
}

.wizard-live-preview-box {
    background-color: rgb(250, 248, 242);
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(56, 189, 248, 0.55);
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-top: 4px;
    margin-bottom: 32px;
    min-height: 320px;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-preview-caption {
    font-size: 30px;
    color: rgb(71, 85, 105);
    margin-bottom: 16px;
}

.wizard-preview-line {
    font-size: 48px;
    color: rgb(20, 20, 20);
    -unity-text-align: middle-left;
    white-space: normal;
    margin: 0;
    margin-bottom: 12px;
}

/* ── Step pages fill the remaining height ── */
.wizard-step-page {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.wizard-step-purpose {
    font-size: 32px;
    color: rgb(203, 213, 225);
    white-space: normal;
    margin-top: 4px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.wizard-prompt-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-shrink: 0;
}

.wizard-prompt {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(241, 245, 249);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.wizard-tts-btn {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    margin: 0;
    margin-left: 24px;
    padding: 0;
    background-color: rgba(2, 132, 199, 0.25);
    border-width: 3px;
    border-color: rgba(56, 189, 248, 0.6);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.wizard-tts-btn:active {
    background-color: rgb(2, 132, 199);
    scale: 0.92;
}

.wizard-tts-icon {
    font-size: 48px;
    color: rgb(56, 189, 248);
    -unity-text-align: middle-center;
}

/* ── Step 1: three spacing chips in one row (touch target >= 134px tall) ── */
.wizard-chip-row {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 24px;
}

.wizard-option-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 160px;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(22, 30, 49);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.wizard-option-card:active { scale: 0.97; }

.wizard-card--selected {
    border-color: rgb(56, 189, 248);
    background-color: rgb(26, 46, 78);
}

.wizard-chip-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
    -unity-text-align: middle-center;
}

/* ── Step 2: the four rows ARE the preview. Tight padding; samples as large as they fit ── */
.wizard-palette-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 150px;
    border-radius: 28px;
    border-width: 4px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 20px;
    flex-direction: column;
    justify-content: center;
    background-color: rgb(250, 248, 242);
    border-color: rgba(0, 0, 0, 0.14);
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.wizard-palette-card:active { scale: 0.98; }

.wizard-palette-card.wizard-card--selected,
.wizard-tint-card.wizard-card--selected {
    border-color: rgb(2, 132, 199);
    border-width: 7px;
}

.wizard-palette-card .wizard-card-title {
    color: rgb(51, 65, 85);
    font-size: 36px;
    margin-bottom: 2px;
}

.wizard-card-title {
    font-size: 36px;
    color: rgb(248, 250, 252);
}

/* Same weight as the preview and the frozen overlay (regular) */
.wizard-palette-sample {
    font-size: 54px;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 3: colour swatches in a 2x2 grid under the preview ── */
.wizard-swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
}

.wizard-tint-card {
    width: 48%;
    height: 150px;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.14);
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.wizard-tint-card:active { scale: 0.97; }

.wizard-tint-card--cream { background-color: rgb(250, 248, 242); }
.wizard-tint-card--mint { background-color: rgb(240, 253, 244); }
.wizard-tint-card--periwinkle { background-color: rgb(241, 245, 249); }
.wizard-tint-card--paper { background-color: rgb(250, 245, 232); }

.wizard-tint-benefit {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 4: compact review rows under the preview ── */
.wizard-review-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 140px;
    flex-shrink: 0;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(22, 30, 49);
    padding-left: 44px;
    padding-right: 44px;
    margin-bottom: 20px;
}

.wizard-review-row:active { scale: 0.98; }

.wizard-review-title {
    font-size: 38px;
    color: rgb(203, 213, 225);
}

.wizard-review-value {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
}

.wizard-change-later-note {
    font-size: 32px;
    color: rgb(203, 213, 225);
    white-space: normal;
    flex-shrink: 0;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
/* ── 4. Bottom action bar: fixed position on every step ── */
.wizard-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 150px;
    flex-shrink: 0;
    padding-top: 24px;
    border-top-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.14);
}

.wizard-nav-btn {
    height: 112px;
    min-width: 260px;
    border-radius: 56px;
    margin: 0;
    padding-left: 52px;
    padding-right: 52px;
    font-size: 40px;
    -unity-font-style: bold;
    border-width: 0;
}

.wizard-btn--back {
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(226, 232, 240);
}

.wizard-btn--back:active {
    background-color: rgba(255, 255, 255, 0.25);
    scale: 0.96;
}

.wizard-btn--skip {
    background-color: transparent;
    color: rgb(203, 213, 225);
    font-size: 32px;
    margin: 0;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
    border-width: 0;
}

.wizard-btn--skip:active {
    color: rgb(241, 245, 249);
}

.wizard-btn--next {
    background-color: rgb(2, 132, 199);
    color: rgb(255, 255, 255);
    min-width: 300px;
}

.wizard-btn--next:active {
    background-color: rgb(3, 105, 161);
    scale: 0.96;
}
