/* ── Dyslexia Onboarding USS: reference canvas 1080x2400 (PanelSettings: ScaleWithScreenSize).
      1 dp on a typical phone ~= 2.8 reference px, so body text >= 44px (~16dp) and
      touch targets >= 134px (48dp) where interactive and not span-wide. ── */

.wizard-fullscreen-root,
.wizard-top-bar,
.wizard-brand-wordmark,
.wizard-step-accessible-label,
.wizard-prompt,
.wizard-step-purpose,
.wizard-card-title,
.wizard-card-preview,
.wizard-palette-sample,
.wizard-tint-benefit,
.wizard-preview-line,
.wizard-preview-summary,
.wizard-change-later-note,
.wizard-nav-btn,
.wizard-btn--skip {
    -unity-font: url("project://database/Assets/Fonts/NeevA-Dyslexia-Regular.ttf?fileID=12800000&guid=83e005baf2790934ebb370ef42525d05&type=3#NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
}

/* ── 1. Full-screen root with safe-area padding ── */
.wizard-fullscreen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(10, 15, 29);
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 84px;
    padding-bottom: 72px;
}

/* ── 2. Top bar: Full-width Duolingo progress bar ── */
.wizard-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 60px;
    flex-shrink: 0;
}

.wizard-step-accessible-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(148, 163, 184);
    margin-left: 28px;
    flex-shrink: 0;
}

.wizard-progress-bar {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 20px;
}

.wizard-progress-seg {
    flex-grow: 1;
    flex-basis: 0;
    height: 18px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.16);
    margin-left: 6px;
    margin-right: 6px;
    transition-property: background-color;
    transition-duration: 0.25s;
}

.wizard-progress-seg--active {
    background-color: rgb(56, 189, 248);
}

.wizard-close-btn {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin: 0;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.wizard-close-btn:active {
    background-color: rgba(239, 68, 68, 0.7);
    scale: 0.92;
}

.wizard-close-icon {
    font-size: 44px;
    color: rgb(226, 232, 240);
    -unity-text-align: middle-center;
}

/* ── 3. Content area: preview (fixed) + step page (takes all remaining height) ── */
.wizard-content-area {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    margin-top: 28px;
    margin-bottom: 28px;
}

/* ── 3. Blackboard / Slate Hero Preview Window ── */
.wizard-slate-frame {
    background-color: rgb(15, 23, 42);
    border-radius: 32px;
    border-width: 4px;
    border-color: rgb(51, 65, 85);
    border-bottom-width: 8px;
    border-bottom-color: rgb(30, 41, 59);
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 16px;
    padding-bottom: 20px;
    margin-bottom: 40px;
    flex-shrink: 0;
}

.wizard-slate-top-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 16px;
    padding-bottom: 12px;
}

.wizard-slate-header-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(148, 163, 184);
    letter-spacing: 2px;
}

.wizard-live-preview-box {
    background-color: rgb(250, 248, 242);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.08);
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 24px;
    padding-bottom: 24px;
    min-height: 220px;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-preview-line {
    font-size: 48px;
    color: rgb(20, 20, 20);
    -unity-text-align: middle-left;
    white-space: normal;
    margin: 0;
    margin-bottom: 8px;
}

/* ── Step pages fill the remaining height; the option cards share it equally ── */
.wizard-step-page {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.wizard-step-purpose {
    font-size: 32px;
    color: rgb(148, 163, 184);
    white-space: normal;
    margin-bottom: 20px;
    flex-shrink: 0;
}

.wizard-prompt-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-shrink: 0;
}

.wizard-prompt {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(241, 245, 249);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.wizard-tts-btn {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    margin: 0;
    margin-left: 24px;
    padding: 0;
    background-color: rgba(2, 132, 199, 0.25);
    border-width: 3px;
    border-color: rgba(56, 189, 248, 0.6);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.wizard-tts-btn:active {
    background-color: rgb(2, 132, 199);
    scale: 0.92;
}

.wizard-tts-icon {
    font-size: 48px;
    color: rgb(56, 189, 248);
    -unity-text-align: middle-center;
}

/* ── Option cards (all steps): equal share of the remaining height ── */
.wizard-option-card,
.wizard-palette-card,
.wizard-tint-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    border-radius: 28px;
    border-width: 4px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-bottom: 20px;
    flex-direction: column;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.wizard-option-card:active,
.wizard-palette-card:active,
.wizard-tint-card:active {
    scale: 0.98;
}

.wizard-option-card {
    min-height: 180px;
    background-color: rgb(22, 30, 49);
    border-color: rgba(255, 255, 255, 0.16);
    border-bottom-width: 8px;
    border-bottom-color: rgba(255, 255, 255, 0.28);
}

.wizard-card--selected {
    border-color: rgb(56, 189, 248);
    background-color: rgb(26, 46, 78);
    border-bottom-width: 8px;
    border-bottom-color: rgb(2, 132, 199);
}

.wizard-card-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(148, 163, 184);
    margin-bottom: 10px;
}

.wizard-card-preview {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
    white-space: nowrap;
}

/* ── Step 2: colour samples sit on paper ── */
.wizard-palette-card {
    min-height: 160px;
    background-color: rgb(250, 248, 242);
    border-color: rgba(0, 0, 0, 0.14);
    border-bottom-width: 8px;
    border-bottom-color: rgba(0, 0, 0, 0.24);
}

.wizard-palette-card.wizard-card--selected,
.wizard-tint-card.wizard-card--selected {
    border-color: rgb(2, 132, 199);
    border-width: 6px;
    border-bottom-width: 9px;
    border-bottom-color: rgb(3, 105, 161);
}

.wizard-palette-card .wizard-card-title {
    color: rgb(71, 85, 105);
    font-size: 34px;
    margin-bottom: 6px;
}

.wizard-palette-sample {
    font-size: 58px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 3: paper colours ── */
.wizard-tint-card {
    min-height: 150px;
    align-items: center;
    border-color: rgba(0, 0, 0, 0.14);
    border-bottom-width: 8px;
    border-bottom-color: rgba(0, 0, 0, 0.24);
}

.wizard-tint-card--cream { background-color: rgb(250, 248, 242); }
.wizard-tint-card--mint { background-color: rgb(240, 253, 244); }
.wizard-tint-card--periwinkle { background-color: rgb(241, 245, 249); }
.wizard-tint-card--paper { background-color: rgb(250, 245, 232); }

.wizard-tint-benefit {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 4: review rows reuse the option-card style and share the height ── */
.wizard-change-later-note {
    font-size: 32px;
    color: rgb(148, 163, 184);
    white-space: normal;
    flex-shrink: 0;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* ── 4. Bottom action bar: Two full-width equal 50/50 thumb pills ── */
.wizard-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 150px;
    flex-shrink: 0;
    padding-top: 24px;
    border-top-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.14);
}

.wizard-nav-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 116px;
    border-radius: 58px;
    margin: 0;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

.wizard-btn--back,
.wizard-btn--secondary {
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.25);
    color: rgb(226, 232, 240);
    margin-right: 18px;
}

.wizard-btn--back:active,
.wizard-btn--secondary:active {
    background-color: rgba(255, 255, 255, 0.28);
    scale: 0.97;
}

.wizard-btn--next {
    background-color: rgb(2, 132, 199);
    border-width: 3px;
    border-color: rgb(56, 189, 248);
    border-bottom-width: 6px;
    border-bottom-color: rgb(3, 105, 161);
    color: rgb(255, 255, 255);
    margin-left: 18px;
}

.wizard-btn--next:active {
    background-color: rgb(3, 105, 161);
    border-bottom-width: 3px;
    scale: 0.97;
}
