.hindi-ar-line, .hindi-dyslexic-reveal {
    position: absolute;
    -unity-font: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-font-definition: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-size: 24px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    white-space: normal;
    overflow: visible;
}


.bottom-action-bar {
    width: 100%;
    height: 110px;
    align-items: center;
    justify-content: center;
    padding-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.35);
}

.scan-button {
    width: 230px;
    height: 64px;
    background-color: #1A73E8;
    color: #FFFFFF;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
    border-width: 0px;
    padding-left: 18px;
    padding-right: 18px;
}

.scan-button:hover {
    background-color: #1557B0;
}

.scan-button:active {
    background-color: #0D47A1;
    scale: 0.95 0.95;
}
