.hindi-ar-line, .hindi-dyslexic-reveal {
    position: absolute;
    -unity-font: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-font-definition: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-size: 32px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 0px;
    margin-right: 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-width: 0px;
    white-space: nowrap;
    overflow: visible;
}

/* ── Fullscreen HUD Container (Pass-through for AR) ── */
.hud-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* ── 1. Top Horizon Level Pill ── */
.level-pill {
    position: absolute;
    top: 48px;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    height: 64px;
    padding-left: 36px;
    padding-right: 36px;
    border-radius: 32px;
    background-color: rgba(4, 8, 16, 0.82);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}

.level-pill--level {
    border-color: rgba(0, 230, 118, 0.85);
    background-color: rgba(0, 32, 16, 0.88);
}

.level-pill--tilted {
    border-color: rgba(51, 153, 255, 0.55);
    background-color: rgba(4, 8, 16, 0.82);
}

.level-pill-text {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #3399FF;
    margin: 0;
    padding: 0;
}

.level-pill--level .level-pill-text {
    color: #00E676;
}

/* ── 2. Viewfinder & Masks (Default mobile proportions) ── */
.viewfinder-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.viewfinder-mask {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.45);
}

.top-mask {
    top: 0;
    left: 0;
    right: 0;
    height: 27%;
}

.bottom-mask {
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
}

.left-mask {
    left: 0;
    top: 27%;
    bottom: 35%;
    width: 7%;
}

.right-mask {
    right: 0;
    top: 27%;
    bottom: 35%;
    width: 7%;
}

.reading-box {
    position: absolute;
    left: 7%;
    top: 27%;
    width: 86%;
    height: 38%;
    overflow: visible;
}

.reading-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.35);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.reading-tint--clear {
    background-color: rgba(255, 255, 255, 0.0);
}

/* 4 L-shaped Corner Brackets */
.corner-bracket {
    position: absolute;
    width: 72px;
    height: 72px;
    border-color: #3399FF;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.corner-tl {
    top: 0;
    left: 0;
    border-top-width: 9px;
    border-left-width: 9px;
}

.corner-tr {
    top: 0;
    right: 0;
    border-top-width: 9px;
    border-right-width: 9px;
}

.corner-bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 9px;
    border-left-width: 9px;
}

.corner-br {
    bottom: 0;
    right: 0;
    border-bottom-width: 9px;
    border-right-width: 9px;
}

.reading-box--level .corner-bracket {
    border-color: #00E676;
}

/* Drag Handles */
.drag-handle-bottom {
    position: absolute;
    bottom: -60px;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    width: 360px;
    height: 96px;
    align-items: center;
    justify-content: center;
}

.handle-pill-h {
    width: 160px;
    height: 14px;
    border-radius: 7px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-bottom:active .handle-pill-h {
    scale: 1.15 1.25;
    background-color: #66DDFF;
}

.handle-label-h {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.drag-handle-right {
    position: absolute;
    right: -60px;
    top: 0;
    bottom: 0;
    margin-top: auto;
    margin-bottom: auto;
    width: 96px;
    height: 320px;
    align-items: center;
    justify-content: center;
}

.handle-pill-v {
    width: 14px;
    height: 160px;
    border-radius: 7px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-right:active .handle-pill-v {
    scale: 1.25 1.15;
    background-color: #66DDFF;
}

.handle-label-v {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    margin-left: 8px;
}

.drag-handle-corner {
    position: absolute;
    right: -40px;
    bottom: -40px;
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
}

.handle-dot {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: #3399FF;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.95);
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-corner:active .handle-dot {
    scale: 1.3 1.3;
    background-color: #66DDFF;
}

.reading-box--level .handle-pill-h,
.reading-box--level .handle-pill-v,
.reading-box--level .handle-dot {
    background-color: #00E676;
}

/* ── 3. Camera Bottom Bar ── */
.camera-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 360px;
    background-color: rgba(3, 5, 8, 0.94);
    align-items: center;
    justify-content: flex-start;
    padding-top: 18px;
}

.mode-carousel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 72px;
    margin-bottom: 24px;
}

.mode-tab {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
}

.mode-tab-text {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.mode-tab--active .mode-tab-text {
    color: #FFB300;
    -unity-font-style: bold;
}

.mode-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #FFB300;
    margin-top: 6px;
}

.mode-dot--hidden {
    visibility: hidden;
}

.camera-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    height: 190px;
    padding-left: 40px;
    padding-right: 40px;
}

.control-side-slot {
    width: 180px;
    align-items: center;
    justify-content: center;
}

.shutter-bezel {
    width: 180px;
    height: 180px;
    border-radius: 90px;
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.90);
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.shutter-core {
    width: 146px;
    height: 146px;
    border-radius: 73px;
    background-color: #FFFFFF;
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.shutter-core:active {
    scale: 0.92 0.92;
}

.shutter-core--scanning {
    background-color: #33C5FF;
}

.shutter-core--rescan {
    background-color: #00E676;
}

.shutter-icon {
    font-size: 54px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.quick-rescan-btn {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.40);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.quick-rescan-btn:active {
    scale: 0.90 0.90;
    background-color: rgba(255, 255, 255, 0.30);
}

.quick-rescan-icon {
    font-size: 42px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
