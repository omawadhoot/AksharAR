.hindi-ar-line, .hindi-dyslexic-reveal {
    position: absolute;
    -unity-font: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-font-definition: resource("Fonts/NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-size: 24px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0px;
    padding-bottom: 0px;
    margin-left: 0px;
    margin-right: 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-width: 0px;
    white-space: nowrap;
    overflow: visible;
}

/* ── Fullscreen HUD Container (Pass-through for AR) ── */
.hud-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* ── 1. Top Horizon Level Pill ── */
.level-pill {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    width: 190px;
    height: 38px;
    border-radius: 19px;
    background-color: rgba(4, 8, 16, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}

.level-pill--level {
    border-color: rgba(0, 230, 118, 0.75);
    background-color: rgba(0, 30, 15, 0.85);
}

.level-pill--tilted {
    border-color: rgba(51, 153, 255, 0.45);
    background-color: rgba(4, 8, 16, 0.78);
}

.level-pill-text {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #3399FF;
    margin: 0;
    padding: 0;
}

.level-pill--level .level-pill-text {
    color: #00E676;
}

/* ── 2. Viewfinder & Masks ── */
.viewfinder-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.viewfinder-mask {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.40);
}

.top-mask {
    top: 0;
    left: 0;
    right: 0;
}

.bottom-mask {
    bottom: 0;
    left: 0;
    right: 0;
}

.left-mask {
    left: 0;
}

.right-mask {
    right: 0;
}

.reading-box {
    position: absolute;
    overflow: visible;
}

.reading-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.35);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.reading-tint--clear {
    background-color: rgba(255, 255, 255, 0.0);
}

/* 4 L-shaped Corner Brackets */
.corner-bracket {
    position: absolute;
    width: 48px;
    height: 48px;
    border-color: #3399FF;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.corner-tl {
    top: 0;
    left: 0;
    border-top-width: 6px;
    border-left-width: 6px;
}

.corner-tr {
    top: 0;
    right: 0;
    border-top-width: 6px;
    border-right-width: 6px;
}

.corner-bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 6px;
    border-left-width: 6px;
}

.corner-br {
    bottom: 0;
    right: 0;
    border-bottom-width: 6px;
    border-right-width: 6px;
}

.reading-box--level .corner-bracket {
    border-color: #00E676;
}

/* Drag Handles */
.drag-handle-bottom {
    position: absolute;
    bottom: -36px;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    width: 240px;
    height: 60px;
    align-items: center;
    justify-content: center;
}

.handle-pill-h {
    width: 110px;
    height: 10px;
    border-radius: 5px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-bottom:active .handle-pill-h {
    scale: 1.15 1.25;
    background-color: #66DDFF;
}

.handle-label-h {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.drag-handle-right {
    position: absolute;
    right: -36px;
    top: 0;
    bottom: 0;
    margin-top: auto;
    margin-bottom: auto;
    width: 60px;
    height: 220px;
    align-items: center;
    justify-content: center;
}

.handle-pill-v {
    width: 10px;
    height: 110px;
    border-radius: 5px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-right:active .handle-pill-v {
    scale: 1.25 1.15;
    background-color: #66DDFF;
}

.handle-label-v {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    margin-left: 6px;
}

.drag-handle-corner {
    position: absolute;
    right: -24px;
    bottom: -24px;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
}

.handle-dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #3399FF;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-corner:active .handle-dot {
    scale: 1.3 1.3;
    background-color: #66DDFF;
}

.reading-box--level .handle-pill-h,
.reading-box--level .handle-pill-v,
.reading-box--level .handle-dot {
    background-color: #00E676;
}

/* ── 3. Camera Bottom Bar ── */
.camera-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 195px;
    background-color: rgba(3, 5, 8, 0.92);
    align-items: center;
    justify-content: flex-start;
    padding-top: 10px;
}

.mode-carousel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 42px;
    margin-bottom: 8px;
}

.mode-tab {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
}

.mode-tab-text {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.50);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.mode-tab--active .mode-tab-text {
    color: #FFB300;
    -unity-font-style: bold;
}

.mode-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #FFB300;
    margin-top: 2px;
}

.mode-dot--hidden {
    visibility: hidden;
}

.camera-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96px;
}

.control-side-slot {
    width: 100px;
    align-items: center;
    justify-content: center;
}

.shutter-bezel {
    width: 86px;
    height: 86px;
    border-radius: 43px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.90);
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.shutter-core {
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: #FFFFFF;
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.shutter-core:active {
    scale: 0.90 0.90;
}

.shutter-core--scanning {
    background-color: #33C5FF;
}

.shutter-core--rescan {
    background-color: #00E676;
}

.shutter-icon {
    font-size: 26px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.quick-rescan-btn {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.35);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.quick-rescan-btn:active {
    scale: 0.90 0.90;
    background-color: rgba(255, 255, 255, 0.28);
}

.quick-rescan-icon {
    font-size: 22px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
