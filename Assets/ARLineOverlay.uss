.hindi-ar-line, .hindi-dyslexic-reveal {
    position: absolute;
    -unity-text-generator: advanced;
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0.95);
    color: #111111;
    font-size: 32px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 0px;
    margin-right: 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-width: 0px;
    white-space: nowrap;
    overflow: visible;
}

/* ── Fullscreen HUD Container (Pass-through for AR) ── */
.hud-overlay {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    -unity-text-generator: advanced;
}

/* ── 1. Top Horizon Level Pill ── */
.level-pill {
    position: absolute;
    top: 52px;
    align-self: center;
    height: 84px;
    padding-left: 36px;
    padding-right: 36px;
    border-radius: 42px;
    background-color: rgba(4, 8, 16, 0.88);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.25);
    align-items: center;
    justify-content: center;
    flex-direction: row;
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}

.level-pill--level {
    border-color: rgba(0, 230, 118, 0.85);
    background-color: rgba(0, 32, 16, 0.88);
}

.level-pill--tilted {
    border-color: rgba(51, 153, 255, 0.65);
    background-color: rgba(4, 8, 16, 0.88);
}

.level-pill-text {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #3399FF;
    margin: 0;
    padding: 0;
}

.level-pill--level .level-pill-text {
    color: #00E676;
}

/* ── 2. Viewfinder & Masks (Default mobile proportions) ── */
.viewfinder-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.viewfinder-mask {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.45);
}

.top-mask {
    top: 0;
    left: 0;
    right: 0;
    height: 27%;
}

.bottom-mask {
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
}

.left-mask {
    left: 0;
    top: 27%;
    bottom: 35%;
    width: 7%;
}

.right-mask {
    right: 0;
    top: 27%;
    bottom: 35%;
    width: 7%;
}

.reading-box {
    position: absolute;
    left: 7%;
    top: 27%;
    width: 86%;
    height: 38%;
    overflow: visible;
}

.reading-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    background-color: rgba(8, 16, 30, 0.36);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.reading-tint--clear {
    background-color: rgba(8, 16, 30, 0.0);
}

/* 4 L-shaped Corner Brackets */
.corner-bracket {
    position: absolute;
    width: 92px;
    height: 92px;
    border-color: #3399FF;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.corner-tl {
    top: 0;
    left: 0;
    border-top-width: 12px;
    border-left-width: 12px;
}

.corner-tr {
    top: 0;
    right: 0;
    border-top-width: 12px;
    border-right-width: 12px;
}

.corner-bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 12px;
    border-left-width: 12px;
}

.corner-br {
    bottom: 0;
    right: 0;
    border-bottom-width: 12px;
    border-right-width: 12px;
}

.reading-box--level .corner-bracket {
    border-color: #00E676;
}

/* Drag Handles */
.drag-handle-bottom {
    position: absolute;
    bottom: -72px;
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    width: 380px;
    height: 110px;
    align-items: center;
    justify-content: center;
}

.handle-pill-h {
    width: 180px;
    height: 22px;
    border-radius: 11px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-bottom:active .handle-pill-h {
    scale: 1.15 1.25;
    background-color: #66DDFF;
}

.handle-label-h {
    font-size: 34px;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.drag-handle-right {
    position: absolute;
    right: -72px;
    top: 0;
    bottom: 0;
    margin-top: auto;
    margin-bottom: auto;
    width: 110px;
    height: 340px;
    align-items: center;
    justify-content: center;
}

.handle-pill-v {
    width: 22px;
    height: 180px;
    border-radius: 11px;
    background-color: #3399FF;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-right:active .handle-pill-v {
    scale: 1.25 1.15;
    background-color: #66DDFF;
}

.handle-label-v {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    margin-left: 8px;
}

.drag-handle-corner {
    position: absolute;
    right: -48px;
    bottom: -48px;
    width: 110px;
    height: 110px;
    align-items: center;
    justify-content: center;
}

.handle-dot {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: #3399FF;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.95);
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.drag-handle-corner:active .handle-dot {
    scale: 1.25 1.25;
    background-color: #66DDFF;
}

.reading-box--level .handle-pill-h,
.reading-box--level .handle-pill-v,
.reading-box--level .handle-dot {
    background-color: #00E676;
}

/* ── 3. Camera Bottom Bar ── */
.camera-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 420px;
    background-color: rgba(3, 5, 8, 0.94);
    align-items: center;
    justify-content: flex-start;
    padding-top: 24px;
}

.mode-carousel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 110px;
    margin-bottom: 24px;
}

.mode-tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
    margin-left: 20px;
    margin-right: 20px;
    min-height: 90px;
    background-color: transparent;
    border-width: 0;
}

/* ── Rhythmic Verse & Prose Text Block Visual Icons (No Emojis) ── */
.mode-icon {
    width: 48px;
    height: 36px;
    justify-content: space-between;
    margin-right: 18px;
}

.mode-icon--poem {
    align-items: center;
}

.mode-icon--chapter {
    align-items: flex-start;
}

.verse-bar {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.45);
    align-self: center;
}

.verse-bar--1 { width: 24px; }
.verse-bar--2 { width: 48px; }
.verse-bar--3 { width: 32px; }

.prose-bar {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.45);
    align-self: flex-start;
}

.prose-bar--1 { width: 48px; }
.prose-bar--2 { width: 48px; }
.prose-bar--3 { width: 32px; }

/* ── Bilingual Text Labels (Dyslexia Devanagari + Latin Subtitle) ── */
.mode-text-group {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
}

.mode-label-devanagari {
    -unity-text-generator: advanced;
    font-size: 56px;
    color: rgba(255, 255, 255, 0.72);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.mode-label-latin {
    font-size: 28px;
    color: rgba(255, 255, 255, 0.52);
    -unity-text-align: middle-left;
    margin: 0;
    margin-top: 4px;
    padding: 0;
}

.mode-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #FFB300;
    margin-left: 18px;
    align-self: center;
}

.mode-dot--hidden {
    visibility: hidden;
}

/* ── Active Selection Accent ── */
.mode-tab--active .verse-bar {
    background-color: #FFB300;
}

.mode-tab--active .prose-bar {
    background-color: #FFB300;
}

.mode-tab--active .mode-label-devanagari {
    color: #FFB300;
    -unity-font-style: bold;
}

.mode-tab--active .mode-label-latin {
    color: #FFD54F;
    -unity-font-style: bold;
}

.camera-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    height: 190px;
    padding-left: 40px;
    padding-right: 40px;
}

.control-side-slot {
    width: 180px;
    align-items: center;
    justify-content: center;
}

.shutter-bezel {
    width: 180px;
    height: 180px;
    border-radius: 90px;
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.90);
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.shutter-core {
    width: 146px;
    height: 146px;
    border-radius: 73px;
    background-color: #FFFFFF;
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color, opacity;
    transition-duration: 0.15s;
    opacity: 1.0;
}

.shutter-core:active {
    scale: 0.92 0.92;
}

.shutter-core--scanning {
    background-color: #33C5FF;
    opacity: 0.85;
}

.shutter-core--tilted {
    background-color: rgba(255, 255, 255, 0.25);
    opacity: 0.35;
}

.shutter-core--reading-locked {
    background-color: rgba(255, 255, 255, 0.15);
    opacity: 0.20;
}

.shutter-core:disabled {
    opacity: 0.35;
}

.shutter-core--rescan {
    background-color: #00E676;
}

.shutter-icon {
    font-size: 54px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.shutter-core--rescan .shutter-icon {
    font-size: 30px;
    -unity-font-style: bold;
    color: #0F172A;
}

.quick-rescan-btn {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    background-color: rgba(15, 23, 42, 0.88);
    border-width: 2.5px;
    border-color: rgba(56, 189, 248, 0.85);
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.quick-rescan-btn:active {
    scale: 0.90 0.90;
    background-color: rgba(56, 189, 248, 0.35);
    border-color: #38BDF8;
}

.quick-rescan-icon {
    width: 58px;
    height: 58px;
    background-image: resource("Icons/Icon_Refresh");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.15s;
}

.quick-rescan-btn:active .quick-rescan-icon {
    -unity-background-image-tint-color: #38BDF8;
    scale: 0.95 0.95;
}

/* ── 4. Landscape Layout Overrides ── */

.camera-bar--landscape {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: auto;
    width: 300px;
    height: 100%;
    background-color: rgba(3, 5, 8, 0.94);
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 0;
    padding-right: 0;
}

/* Mode Carousel in Landscape: Exact same visual identity as portrait (pure typography + active dot) */
.camera-bar--landscape .mode-carousel,
.mode-carousel--landscape {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: auto;
    width: 100%;
    margin-top: 24px;
    margin-bottom: 0;
}

.camera-bar--landscape .mode-tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 0;
    margin-right: 0;
}

.camera-bar--landscape .mode-label-devanagari {
    font-size: 48px;
}

.camera-bar--landscape .mode-label-latin {
    font-size: 24px;
}

/* Camera Controls in Landscape: Vertical distribution with large separation */
.camera-bar--landscape .camera-controls-row,
.camera-controls-row--landscape {
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    width: 100%;
    height: auto;
    flex-grow: 1;
    padding-left: 0;
    padding-right: 0;
    margin-top: 24px;
    margin-bottom: 12px;
}

.camera-bar--landscape #LeftSpacerSlot {
    display: none;
}

.camera-bar--landscape .shutter-bezel {
    width: 180px;
    height: 180px;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.camera-bar--landscape #RightRescanSlot {
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 50px;
}

.camera-bar--landscape .quick-rescan-btn {
    width: 100px;
    height: 100px;
    align-self: center;
}

.viewfinder-root--landscape {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 300px;
    width: auto;
    height: 100%;
}

.hud-overlay--landscape .top-controls-container,
.top-controls-container.top-controls-container--landscape {
    position: absolute;
    top: 24px;
    left: 28px;
    right: 328px;
    height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.hud-overlay--landscape .level-pill,
.level-pill.level-pill--landscape {
    position: absolute;
    top: 0;
    align-self: center;
    margin-right: 0;
    left: auto;
    right: auto;
}

.hud-overlay--landscape .settings-top-button,
.settings-top-button.settings-button--landscape {
    position: absolute;
    right: 0px;
    top: 0px;
    width: 88px;
    height: 88px;
    border-radius: 44px;
}

/* Container rules covering the absolute boundaries of the 2048x2898 Canvas */
#TextContainer {
    position: absolute;
    width: 2048px;
    height: 2898px;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

/* Individual label baseline style parameters overrides */
#TextContainer > Label {
    margin: 0;
    padding: 0;
    color: #1A1A1A; /* High contrast dark charcoal for dyslexic accessibility print */
}

/* ── In-Situ Freeze-Frame AR Overlay Styles ── */
.freeze-frame-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
    background-color: transparent;
}

.freeze-frame-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: resource("Textures/Vignette_Spotlight");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity;
    transition-duration: 0.3s;
    opacity: 1;
}

.freeze-frame-text-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: transparent;
}

.freeze-frame-card {
    position: absolute;
    border-radius: 8px;
    transition-property: opacity, transform;
    transition-duration: 0.2s;
}

.freeze-frame-line {
    position: absolute;
    -unity-text-generator: advanced;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: visible;
    background-color: transparent;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.freeze-frame-line:active,
.freeze-frame-line--highlighted {
    background-color: rgba(255, 215, 0, 0.35);
    scale: 1.02;
}

/* ── Top Bar Controls (Level Pill + Accessibility Settings) ── */
.top-controls-container {
    position: absolute;
    top: 52px;
    left: 28px;
    right: 28px;
    height: 128px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.settings-top-button {
    position: absolute;
    right: 0px;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(15, 23, 42, 0.94);
    border-width: 3.5px;
    border-color: rgb(56, 189, 248);
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.settings-top-button:active {
    scale: 0.92;
    background-color: rgb(2, 132, 199);
    border-color: rgb(255, 255, 255);
}

.settings-button-icon {
    width: 52px;
    height: 52px;
    background-image: resource("Icons/Icon_Settings");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.settings-button-label {
    display: none;
}

/* -------------------------------------------------------------------------- */
/* -- Dyslexia Calibration Wizard Full-Screen Styling (1080x2400 reference) -- */
/* ── Dyslexia Onboarding USS: reference canvas 1080x2400 (PanelSettings: ScaleWithScreenSize).
      1 dp on a typical phone ~= 2.8 reference px, so body text >= 44px (~16dp) and
      touch targets >= 134px (48dp) where interactive and not span-wide. ── */

.wizard-fullscreen-root,
.wizard-top-bar,
.wizard-brand-wordmark,
.wizard-step-accessible-label,
.wizard-prompt,
.wizard-step-purpose,
.wizard-card-title,
.wizard-card-preview,
.wizard-palette-sample,
.wizard-tint-benefit,
.wizard-preview-line,
.wizard-preview-summary,
.wizard-change-later-note,
.wizard-preview-caption,
.wizard-chip-label,
.wizard-review-title,
.wizard-review-value,
.wizard-nav-btn,
.wizard-btn--skip {
    -unity-font: url("project://database/Assets/Fonts/NeevA-Dyslexia-Regular.ttf?fileID=12800000&guid=83e005baf2790934ebb370ef42525d05&type=3#NeevA-Dyslexia-Regular");
    -unity-text-generator: advanced;
}

/* ── 1. Full-screen root with safe-area padding ── */
.wizard-fullscreen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(10, 15, 29);
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 84px;
    padding-bottom: 72px;
}

/* ── 2. Top bar ── */
.wizard-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 112px;
    flex-shrink: 0;
}

.wizard-brand-group {
    flex-direction: column;
    justify-content: center;
}

.wizard-brand-wordmark {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(56, 189, 248);
}

/* Kept in the tree for screen readers / logs, never shown to the child */
.wizard-step-accessible-label {
    display: none;
    font-size: 26px;
    color: rgb(148, 163, 184);
}

.wizard-progress-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.wizard-progress-seg {
    width: 84px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.18);
    margin-left: 7px;
    margin-right: 7px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-progress-seg--active {
    background-color: rgb(56, 189, 248);
}

.wizard-close-btn {
    display: none;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin: 0;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.wizard-close-btn:active {
    background-color: rgba(239, 68, 68, 0.7);
    scale: 0.92;
}

.wizard-close-icon {
    font-size: 44px;
    color: rgb(226, 232, 240);
    -unity-text-align: middle-center;
}

/* ── 3. Content area: preview (fixed) + step page (takes all remaining height) ── */
.wizard-content-area {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    margin-top: 28px;
    margin-bottom: 28px;
}

.wizard-live-preview-box {
    background-color: rgb(250, 248, 242);
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(56, 189, 248, 0.55);
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-top: 4px;
    margin-bottom: 32px;
    min-height: 320px;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.wizard-preview-caption {
    font-size: 30px;
    color: rgb(71, 85, 105);
    margin-bottom: 16px;
}

.wizard-preview-line {
    font-size: 48px;
    color: rgb(20, 20, 20);
    -unity-text-align: middle-left;
    white-space: normal;
    margin: 0;
    margin-bottom: 12px;
}

/* ── Step pages fill the remaining height ── */
.wizard-step-page {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.wizard-step-purpose {
    font-size: 32px;
    color: rgb(203, 213, 225);
    white-space: normal;
    margin-top: 4px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.wizard-prompt-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-shrink: 0;
}

.wizard-prompt {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(241, 245, 249);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.wizard-tts-btn {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    margin: 0;
    margin-left: 24px;
    padding: 0;
    background-color: rgba(2, 132, 199, 0.25);
    border-width: 3px;
    border-color: rgba(56, 189, 248, 0.6);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.wizard-tts-btn:active {
    background-color: rgb(2, 132, 199);
    scale: 0.92;
}

.wizard-tts-icon {
    font-size: 48px;
    color: rgb(56, 189, 248);
    -unity-text-align: middle-center;
}

/* ── Step 1: three spacing chips in one row (touch target >= 134px tall) ── */
.wizard-chip-row {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 24px;
}

.wizard-option-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 160px;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(22, 30, 49);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.wizard-option-card:active { scale: 0.97; }

.wizard-card--selected {
    border-color: rgb(56, 189, 248);
    background-color: rgb(26, 46, 78);
}

.wizard-chip-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
    -unity-text-align: middle-center;
}

/* ── Step 2: the four rows ARE the preview. Tight padding; samples as large as they fit ── */
.wizard-palette-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 150px;
    border-radius: 28px;
    border-width: 4px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 20px;
    flex-direction: column;
    justify-content: center;
    background-color: rgb(250, 248, 242);
    border-color: rgba(0, 0, 0, 0.14);
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.wizard-palette-card:active { scale: 0.98; }

.wizard-palette-card.wizard-card--selected,
.wizard-tint-card.wizard-card--selected {
    border-color: rgb(2, 132, 199);
    border-width: 7px;
}

.wizard-palette-card .wizard-card-title {
    color: rgb(51, 65, 85);
    font-size: 36px;
    margin-bottom: 2px;
}

.wizard-card-title {
    font-size: 36px;
    color: rgb(248, 250, 252);
}

/* Same weight as the preview and the frozen overlay (regular) */
.wizard-palette-sample {
    font-size: 54px;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 3: colour swatches in a 2x2 grid under the preview ── */
.wizard-swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    flex-shrink: 0;
}

.wizard-tint-card {
    width: 48%;
    height: 150px;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.14);
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.wizard-tint-card:active { scale: 0.97; }

.wizard-tint-card--cream { background-color: rgb(250, 248, 242); }
.wizard-tint-card--mint { background-color: rgb(240, 253, 244); }
.wizard-tint-card--periwinkle { background-color: rgb(241, 245, 249); }
.wizard-tint-card--paper { background-color: rgb(250, 245, 232); }

.wizard-tint-benefit {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* ── Step 4: compact review rows under the preview ── */
.wizard-review-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 140px;
    flex-shrink: 0;
    border-radius: 28px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(22, 30, 49);
    padding-left: 44px;
    padding-right: 44px;
    margin-bottom: 20px;
}

.wizard-review-row:active { scale: 0.98; }

.wizard-review-title {
    font-size: 38px;
    color: rgb(203, 213, 225);
}

.wizard-review-value {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
}

.wizard-change-later-note {
    font-size: 32px;
    color: rgb(203, 213, 225);
    white-space: normal;
    flex-shrink: 0;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
/* ── 4. Bottom action bar: fixed position on every step ── */
.wizard-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 150px;
    flex-shrink: 0;
    padding-top: 24px;
    border-top-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.14);
}

.wizard-nav-btn {
    height: 112px;
    min-width: 260px;
    border-radius: 56px;
    margin: 0;
    padding-left: 52px;
    padding-right: 52px;
    font-size: 40px;
    -unity-font-style: bold;
    border-width: 0;
}

.wizard-btn--back {
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(226, 232, 240);
}

.wizard-btn--back:active {
    background-color: rgba(255, 255, 255, 0.25);
    scale: 0.96;
}

.wizard-btn--skip {
    background-color: transparent;
    color: rgb(203, 213, 225);
    font-size: 32px;
    margin: 0;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
    border-width: 0;
}

.wizard-btn--skip:active {
    color: rgb(241, 245, 249);
}

.wizard-btn--next {
    background-color: rgb(2, 132, 199);
    color: rgb(255, 255, 255);
    min-width: 300px;
}

.wizard-btn--next:active {
    background-color: rgb(3, 105, 161);
    scale: 0.96;
}
