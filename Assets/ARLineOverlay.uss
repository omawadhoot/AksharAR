.hindi-ar-line {
    position: absolute;
    -unity-font-definition: url("project://database/Assets/Fonts/NeevA-Dyslexia-Regular.ttf");
    -unity-text-generator: advanced;
    -unity-text-align: upper-left;
    background-color: rgba(255, 255, 255, 0.85);
    color: #111111;
    font-size: 20px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    white-space: normal;
}
